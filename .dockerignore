# Keep the build context (and image layers) lean and secret-free.
# The Dockerfile does `COPY . .`, so anything not excluded here is baked
# into the image.

# Secrets -- never copy .env into the image.
.env
.env.*
!.env.example

# Virtualenvs (wrong arch + huge; deps come from requirements.txt).
.venv/
venv/
env/

# Local runtime artifacts (8h-ephemeral by design; regenerated at runtime).
logs/
label_history/
ship_history.json

# Python caches / build cruft.
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# VCS + editor.
.git/
.gitignore
.dockerignore

# Tests and docs are not needed in the runtime image.
tests/
docs/
*.md
!README.md
