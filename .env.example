# Copy to .env and fill in. The actual .env is gitignored.
# The Settings page in the running app can also write to .env at
# runtime, but the values below are what the process needs to BOOT.

# -- Flask --
# Required. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
PORT=5001
DEBUG=false

# -- USB Scale Hardware IDs --
# Default values match the Mettler Toledo / DYMO scales commonly
# used in small warehouse setups. Adjust to your scale's USB VID/PID.
SCALE_VENDOR_ID=0x0b67
SCALE_PRODUCT_ID=0x555e

# -- Label Cache --
LABEL_MAX_AGE_HOURS=8

# -- Order backend --
# Pluggable order backend selector. The Sentry implementation is in
# progress; leave blank or set to 'sentry' once the integration lands.
BACKEND=
SENTRY_BASE_URL=

# -- ShipRush --
# Get from your ShipRush account. Can also be set later via the
# Settings page (writes back to this file).
SHIPRUSH_TOKEN=
SHIPRUSH_ENDPOINT=https://api.my.shiprush.com/shipmentservice.svc/shipment/ship

# -- Logging --
LOG_LEVEL=INFO
LOG_DIR=logs
